{
  "name": "tw-mawsim-landing-kit",
  "version": "1.1.0",
  "private": true,
  "description": "Mawsim — Arabic-first landing page components for Salla seasonal campaigns and product launches",
  "type": "module",
  "author": "Sukkari <melsukkari@gmail.com>",
  "license": "UNLICENSED",
  "keywords": ["salla", "twilight", "bundle", "landing-page", "rtl", "web-components", "lit-element"],
  "dependencies": {
    "@salla.sa/twilight-bundles": "0.1.63",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-bundle.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run validate",
    "preview:public": "tw-preview",
    "format": "prettier --write \"src/**/*.ts\""
  }
}
